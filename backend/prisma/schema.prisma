// Prisma Schema for BrewLite Cashless Coffee Ordering System

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum InventoryMovementType {
  PURCHASE
  ORDER_DEDUCTION
  ORDER_REVERSAL
  ADJUSTMENT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum UserRole {
  CUSTOMER
  BARISTA
  ADMIN
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  fullName           String?
  role               UserRole            @default(CUSTOMER)
  loyaltyPoints      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orders             Order[]
  purchaseReceipts   PurchaseReceipt[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String
  stock       Int         @default(100)
  version     Int         @default(0) // Optimistic Locking (Task 10.3)
  category    String      @default("coffee")
  sizes       Json? // [{"size": "S", "price": 35000}, {"size": "M", "price": 42000}, {"size": "L", "price": 48000}]
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  recipes     Recipe[]

  @@map("products")
}

model Topping {
  id        String   @id @default(uuid())
  name      String   @unique
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(100)
  version   Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipes   Recipe[]

  @@map("toppings")
}

model Voucher {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(FIXED)
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        Order[]

  @@map("vouchers")
}

model Order {
  id                 String              @id @default(uuid())
  orderNumber        String?             @unique // e.g. "#1042" cho quầy nhận nước
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  status             OrderStatus         @default(PENDING)
  subtotal           Decimal             @db.Decimal(10, 2)
  discountAmount     Decimal             @default(0) @db.Decimal(10, 2)
  total              Decimal             @db.Decimal(10, 2)
  voucherId          String?
  voucher            Voucher?            @relation(fields: [voucherId], references: [id])
  voucherCode        String?
  pointsUsed         Int                 @default(0)
  pointsEarned       Int                 @default(0) // Cộng sau khi đơn PAID (Task 10.4)
  note               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              OrderItem[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]

  @@map("orders")
}

model OrderItem {
  id               String                 @id @default(uuid())
  orderId          String
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product                @relation(fields: [productId], references: [id])
  size             String // S, M, L hoặc STANDARD
  basePrice        Decimal                @db.Decimal(10, 2)
  qty              Int                    @default(1)
  lineTotal        Decimal                @db.Decimal(10, 2)
  toppings         Json? // Snapshot: [{"id": "top-1", "name": "Trân châu", "price": 5000}]
  ingredientUsages OrderIngredientUsage[]

  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  idempotencyKey String        @unique // Idempotent payment (Task 10.2)
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(WALLET)
  status         PaymentStatus @default(SUCCESS)
  transactionId  String?
  createdAt      DateTime      @default(now())

  @@map("payments")
}

model Ingredient {
  id                String                 @id @default(uuid())
  name              String                 @unique
  unit              String
  currentQuantity   Decimal                @default(0) @db.Decimal(14, 3)
  lowStockThreshold Decimal                @default(0) @db.Decimal(14, 3)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  recipeItems       RecipeIngredient[]
  orderUsages       OrderIngredientUsage[]
  receiptItems      PurchaseReceiptItem[]
  movements         InventoryMovement[]

  @@map("ingredients")
}

model Recipe {
  id            String             @id @default(uuid())
  productId     String?
  product       Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  toppingId     String?
  topping       Topping?           @relation(fields: [toppingId], references: [id], onDelete: Cascade)
  size          String?
  isProvisional Boolean            @default(true)
  items         RecipeIngredient[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([productId, size])
  @@unique([toppingId])
  @@map("recipes")
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 3)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model OrderIngredientUsage {
  id           String     @id @default(uuid())
  orderItemId  String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 3)
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, ingredientId])
  @@map("order_ingredient_usages")
}

model PurchaseReceipt {
  id            String                @id @default(uuid())
  receiptNumber String                @unique
  supplierName  String?
  invoiceNumber String?
  note          String?
  createdById   String
  createdBy     User                  @relation(fields: [createdById], references: [id])
  items         PurchaseReceiptItem[]
  movements     InventoryMovement[]
  createdAt     DateTime              @default(now())

  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id           String          @id @default(uuid())
  receiptId    String
  ingredientId String
  quantity     Decimal         @db.Decimal(14, 3)
  unitCost     Decimal?        @db.Decimal(12, 2)
  receipt      PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([receiptId, ingredientId])
  @@map("purchase_receipt_items")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  ingredientId  String
  type          InventoryMovementType
  quantityDelta Decimal               @db.Decimal(14, 3)
  note          String?
  orderId       String?
  receiptId     String?
  actorId       String?
  ingredient    Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receipt       PurchaseReceipt?      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actor         User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@unique([orderId, ingredientId, type])
  @@unique([receiptId, ingredientId, type])
  @@index([ingredientId, createdAt])
  @@map("inventory_movements")
}
