# ==========================================
# BrewLite - Root .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Build Outputs & Bundles
dist/
build/
out/
.next/
.turbo/
.cache/

# NestJS & TypeScript Artifacts
*.tsbuildinfo
*.js.map
*.d.ts.map

# Database & Prisma
prisma/*.db
prisma/*.db-journal
postgres_data/
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# IDEs & Code Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Docker & Temporary Files
docker-data/
*.pid
*.seed
*.pid.lock
tmp/
temp/
