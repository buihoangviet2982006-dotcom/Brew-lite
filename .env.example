# ==========================================
# BrewLite - Root Environment Variables Example
# ==========================================

# Application Environment
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=brewlite_admin
POSTGRES_PASSWORD=brewlite_secure_password
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brewlite_admin:brewlite_secure_password@localhost:5432/brewlite_db?schema=public

# Backend (NestJS)
BACKEND_PORT=4000
JWT_SECRET=super_secret_jwt_key_for_brewlite_2026
JWT_EXPIRATION=7d

# Frontend (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Payment Mock Configuration
PAYMENT_GATEWAY_URL=http://localhost:4000/api/mock-payment
